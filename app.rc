// app.rc - Windows PE Resource Script for predator-fan-ctl
#define RT_MANIFEST 24

// 1. Main Application Icon (ID = 1 ensures Windows Explorer picks it as the primary EXE icon)
1 ICON "assets/predator.ico"

// 2. UAC Administrator & DPI Manifest (Disabled in RC to avoid MinGW .rsrc merge failure)
// 1 RT_MANIFEST "app.manifest"

// 3. PE Version Information (Hiển thị trong tab Details của File Properties & Task Manager)
1 VERSIONINFO
FILEVERSION 1,5,1,0
PRODUCTVERSION 1,5,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Predator Thermal Engineering"
            VALUE "FileDescription", "Predator Fan Controller (Win32 Native)"
            VALUE "FileVersion", "1.5.1.0"
            VALUE "InternalName", "predator-fan-ctl.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "predator-fan-ctl.exe"
            VALUE "ProductName", "Predator Fan Controller"
            VALUE "ProductVersion", "1.5.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
